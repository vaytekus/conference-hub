@{
    ViewData["Title"] = "Admin";
}

<h1 class="mb-4">Admin</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Reports</h5>
                <p class="card-text text-muted">Room utilization and revenue breakdown for a selected period.</p>
                <a asp-controller="Reports" asp-action="Index" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Manage Rooms</h5>
                <p class="card-text text-muted">Create, edit or remove conference rooms.</p>
                <a asp-controller="AdminRooms" asp-action="Index" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Manage Services</h5>
                <p class="card-text text-muted">Create, edit or remove available services (catering, projector, etc).</p>
                <a asp-controller="AdminServices" asp-action="Index" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
</div>