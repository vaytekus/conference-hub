@model ConferenceHub.Web.ViewModels.ReportsIndexViewModel

@{
    ViewData["Title"] = "Reports";
}

<h1 class="mb-4">Reports</h1>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label asp-for="StartDate" class="form-label">From</label>
        <input asp-for="StartDate" type="date" class="form-control"/>
    </div>
    <div class="col-auto">
        <label asp-for="EndDate" class="form-label">To</label>
        <input asp-for="EndDate" type="date" class="form-control"/>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Show</button>
    </div>
    <div asp-validation-summary="All" class="text-danger"></div>
</form>

@if (Model.HasResults)
{
    <h2 class="mt-4">Room Utilization</h2>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Room</th>
            <th class="text-end">Hours booked</th>
            <th class="text-end">Hours available</th>
            <th class="text-end">Utilization %</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Utilization!)
        {
            <tr>
                <td>@row.RoomName</td>
                <td class="text-end">@row.HoursBooked.ToString("0.##")</td>
                <td class="text-end">@row.HoursAvailable.ToString("0.##")</td>
                <td class="text-end">@row.UtilizationPercent.ToString("0.##")%</td>
            </tr>
        }
        </tbody>
    </table>

    <h2 class="mt-5">Revenue</h2>
    <p class="lead">Grand total: <strong>@Model.Revenue!.GrandTotal.ToString("0.00")</strong></p>

    <h4 class="mt-4">By Room</h4>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Room</th>
            <th class="text-end">Total</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Revenue.ByRoom)
        {
            <tr>
                <td>@row.RoomName</td>
                <td class="text-end">@row.Total.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>

    <h4 class="mt-4">By Service</h4>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Service</th>
            <th class="text-end">Total</th>
            <th class="text-end">Times booked</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Revenue.ByService)
        {
            <tr>
                <td>@row.ServiceName</td>
                <td class="text-end">@row.Total.ToString("0.00")</td>
                <td class="text-end">@row.TimesBooked</td>
            </tr>
        }
        </tbody>
    </table>
}