@model RoomsIndexViewModel

@{
    ViewData["Title"] = "Rooms";
}

<h1 class="mb-4">Conference Rooms</h1>

<form method="get" class="mb-4 p-3 border rounded bg-light">
    <div class="row gx-3 mb-3">
        <div class="col-md-2">
            <label asp-for="MinCapacity" class="form-label"></label>
            <input asp-for="MinCapacity" class="form-control" type="number" min="1" />
            <span asp-validation-for="MinCapacity" class="text-danger"></span>
        </div>

        <div class="col-md-5">
            <label asp-for="StartTime" class="form-label"></label>
            <div class="input-group" data-datetime-picker>
                <input type="date" class="form-control"/>
                <select class="form-select" style="max-width: 110px;">
                    <option value="">Hour</option>
                    @for (var h = 6; h <= 22; h++)
                    {
                        <option value="@h">@($"{h:00}:00")</option>
                    }
                </select>
                <input asp-for="StartTime" type="hidden"/>
            </div>
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div class="col-md-5">
            <label asp-for="EndTime" class="form-label"></label>
            <div class="input-group" data-datetime-picker>
                <input type="date" class="form-control"/>
                <select class="form-select" style="max-width: 110px;">
                    <option value="">Hour</option>
                    @for (var h = 7; h <= 23; h++)
                    {
                        <option value="@h">@($"{h:00}:00")</option>
                    }
                </select>
                <input asp-for="EndTime" type="hidden"/>
            </div>
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (Model.Rooms.Count == 0)
{
    <div class="alert alert-info">
        No rooms match your filter.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>Name</th>
            <th>Capacity</th>
            <th>Price / hour</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var room in Model.Rooms)
        {
            <tr>
                <td>@room.Name</td>
                <td>@room.Capacity</td>
                <td>@room.PricePerHour.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@room.Id" class="btn btn-sm btn-outline-primary">
                        Details
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/datetime-picker.js" asp-append-version="true"></script>
}
