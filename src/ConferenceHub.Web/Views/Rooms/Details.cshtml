@model RoomDetailsDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Back to rooms</a>
</div>

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-3">Capacity</dt>
    <dd class="col-sm-9">@Model.Capacity people</dd>

    <dt class="col-sm-3">Price per hour</dt>
    <dd class="col-sm-9">@Model.PricePerHour.ToString("C")</dd>
</dl>

<h3 class="mt-4">Available Services</h3>

@if (Model.Services.Count == 0)
{
    <p class="text-muted">No additional services available for this room.</p>
}
else
{
    <table class="table table-sm table-bordered">
        <thead>
        <tr>
            <th>Service</th>
            <th class="text-end">Price</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var service in Model.Services)
        {
            <tr>
                <td>@service.Name</td>
                <td class="text-end">@service.Price.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
}

<h3 class="mt-4">Booked slots</h3>

<form method="get" class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <label class="mb-0">From</label>
    <input type="date" name="date" class="form-control" style="width:180px"
           value="@(((DateOnly)ViewBag.AvailabilityFrom).ToString("yyyy-MM-dd"))" />
    <label class="mb-0">To</label>
    <input type="date" name="dateTo" class="form-control" style="width:180px"
           value="@(((DateOnly)ViewBag.AvailabilityTo).ToString("yyyy-MM-dd"))" />
    <button type="submit" class="btn btn-outline-secondary btn-sm">Show</button>
</form>

@{
    var bookedSlots = ViewBag.BookedSlots as IReadOnlyList<RoomSlotDto> ?? new List<RoomSlotDto>();
}

@if (!bookedSlots.Any())
{
    <p class="text-success">No bookings for this period.</p>
}
else
{
    <ul class="list-group mb-3" style="max-width:420px">
        @foreach (var slot in bookedSlots)
        {
            var sameDay = slot.Start.Date == slot.End.Date;
            var startStr = slot.Start.ToString("MMM d, HH:mm");
            var endStr   = sameDay ? slot.End.ToString("HH:mm") : slot.End.ToString("MMM d, HH:mm");
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    <span class="text-muted small">From</span> @startStr
                    <span class="text-muted small ms-2">To</span> @endStr
                </span>
                <span class="badge bg-danger ms-2">Booked</span>
            </li>
        }
    </ul>
}

<div class="mt-4">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Reservations" asp-action="Create" asp-route-roomId="@Model.Id" class="btn btn-primary">
            Book this room
        </a>
    }
    else
    {
        <div class="alert alert-warning">
            <a asp-controller="Account" asp-action="Login">Sign in</a> to book this room.
        </div>
    }
</div>