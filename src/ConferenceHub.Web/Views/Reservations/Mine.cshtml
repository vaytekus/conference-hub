@using ConferenceHub.Application.DTOs.Reservations
@model IReadOnlyList<ReservationDto>

@{
    ViewData["Title"] = "My Reservations";
}

<h1>My Reservations</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have no reservations yet.
        <a asp-controller="Rooms" asp-action="Index" class="alert-link">Browse rooms</a>
        to make your first booking.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Room</th>
            <th>From</th>
            <th>To</th>
            <th>Services</th>
            <th class="text-end">Total</th>
            <th>Booked at</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var res in Model)
        {
            <tr>
                <td>
                    <a asp-controller="Rooms" asp-action="Details" asp-route-id="@res.RoomId">
                        @res.RoomName
                    </a>
                </td>
                <td>@res.StartTime.ToString("g")</td>
                <td>@res.EndTime.ToString("g")</td>
                <td>
                    @if (res.Services.Count == 0)
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        @string.Join(", ", res.Services.Select(s => s.ServiceName))
                    }
                </td>
                <td class="text-end"><strong>@res.TotalPrice.ToString("C")</strong></td>
                <td>@res.CreatedAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
        </tbody>
    </table>
}

<a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-primary">Browse rooms</a>